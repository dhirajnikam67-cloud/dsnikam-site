{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-v1.:minor(0|1|2|3).pdf",
      "destination": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-v1.5.pdf",
      "permanent": true
    },
    {
      "source": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-Summary-v1.:minor(0|1|2|3).pdf",
      "destination": "/karnataka-banking-2026",
      "permanent": true
    }
  ]
}
