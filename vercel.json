{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!maintenance|favicon\\.svg).*)",
      "destination": "/maintenance",
      "permanent": false
    },
    {
      "source": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-v1.:minor(0|1|2|3|4|5).pdf",
      "destination": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-v1.6.pdf",
      "permanent": true
    },
    {
      "source": "/karnataka-banking-2026/Karnataka-Storage-Decision-Brief-Summary-v1.:minor(0|1|2|3).pdf",
      "destination": "/karnataka-banking-2026",
      "permanent": true
    },
    {
      "source": "/grid-connectivity-report-4",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/grid-seats",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/projects/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tenders",
      "destination": "/",
      "permanent": false
    }
  ]
}
